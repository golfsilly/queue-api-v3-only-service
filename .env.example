# ---------- ฐานข้อมูลระบบคิวเดิม (webaranhos) ----------
# ใช้ตารางเดิม: queueService, queueUsers, queueListCallnameDepartment (ไม่สร้าง/ไม่แก้โครงสร้าง)
# ถ้ารหัสผ่านมีอักขระพิเศษ ต้อง encode ก่อน เช่น @ -> %40
DATABASE_URL="mysql://USER:PASSWORD@192.168.4.30:3306/webaranhos?connection_limit=10&pool_timeout=10"

# ---------- HOSxP (ใช้ user ที่ SELECT ได้อย่างเดียว) ----------
HOSXP_HOST=
HOSXP_PORT=3306
HOSXP_USER=
HOSXP_PASSWORD=
HOSXP_DATABASE=hos
HOSXP_CONNECTION_LIMIT=5
HOSXP_QUERY_TIMEOUT_MS=10000

# ---------- queue-api ----------
PORT=5600
# ใช้เซ็น token ตอน login
JWT_SECRET=CHANGE_ME_LONG_RANDOM
CORS_ORIGINS=*

# ---------- ใช้กับสคริปต์ศึกษาระบบเดิมเท่านั้น (scripts/) อ่านอย่างเดียว ----------
LEGACY_DB_HOST=
LEGACY_DB_PORT=3306
LEGACY_DB_USER=
LEGACY_DB_PASSWORD=
LEGACY_DB_DATABASE=webaranhos
